# Copia este archivo como ".env" (sin .example) y completa tus datos reales.
# El archivo ".env" NUNCA debe subirse a git ni compartirse.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Fuente de datos EN VIVO (el backtesting siempre usa CSV, esto no lo afecta) ---
# twelve_data (nuevo, v4.0): API en la nube, NO requiere ningún terminal
#   abierto. Necesitas TWELVE_DATA_API_KEY (ver más abajo).
# mt5: requiere terminal MetaTrader 5 abierto en Windows con sesión iniciada.
DATA_SOURCE=twelve_data

# --- Twelve Data (twelvedata.com) — NUEVO v4.0 ---
# Consigue una key gratis en https://twelvedata.com/pricing (plan Basic).
# Plan gratuito: 8 llamadas/min, 800/día, 1 crédito por símbolo por llamada.
TWELVE_DATA_API_KEY=

# --- MetaTrader 5 (opcional, solo si DATA_SOURCE=mt5) ---
# Si los dejas vacíos, THOR usa la sesión ya abierta en tu terminal MT5 local.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Estrategia / operación ---
# SYMBOLS es el nombre nuevo (v4.0); PARES sigue funcionando igual si ya
# lo tenías configurado así. No pongas demasiados pares con Twelve Data
# gratis -- cada par consume 1 crédito por ciclo de escaneo (ver abajo).
SYMBOLS=EURUSD,GBPUSD,USDJPY,EURJPY,GBPJPY

# Timeframe de las velas, en formato Twelve Data (1min, 5min, 15min, etc.)
INTERVAL=1min

# Minutos hasta la expiración de la operación (antes EXPIRACION_MINUTOS,
# incluida aquí con el nombre nuevo -- cualquiera de los dos funciona).
EXPIRY_MINUTES=3

# Score mínimo 0-100 para que se considere señal (antes PROBABILIDAD_MINIMA).
MIN_SCORE=90

# Segundos entre cada ciclo de escaneo (antes INTERVALO_ESCANEO_SEGUNDOS).
# Si lo dejas vacío, con DATA_SOURCE=twelve_data se calcula automáticamente
# para NO agotar el cupo diario de 800 llamadas según cuántos SYMBOLS
# tengas -- no lo bajes a mano sin entender el límite de la API gratuita.
# SCAN_SECONDS=

COOLDOWN_MINUTOS=3
MODO=PRACTICA

# NUEVO en v2: motor de decisión.
#   confluencia_total -> comportamiento v1 (6/6 obligatorio). Por defecto.
#   score_ponderado    -> motor nuevo (Fase 3). NO lo actives en vivo sin
#                         antes correr backtesting/run_backtest.py y
#                         comparar resultados contra confluencia_total.
STRATEGY_MODE=confluencia_total

# NUEVO en v2: payout real de tu bróker/IQ Option, para que el profit
# factor del backtesting sea correcto (no lo dejes en el valor por defecto
# sin verificarlo contra tu plataforma).
PAYOUT_PCT=0.87

# NUEVO en v2: gestor de riesgo (notificaciones, no ejecución de órdenes).
MAX_SENALES_POR_HORA=4
MAX_SENALES_POR_PAR_POR_DIA=6
MAX_PERDIDAS_CONSECUTIVAS=4

# NUEVO en v2.1: filtro de volatilidad ATR (evita señales en mercado
# "choppy" de baja volatilidad — ver indicators/volatility_filter.py).
# Apagado por defecto: compáralo en backtesting antes de activarlo.
ATR_FILTRO_ACTIVO=false
ATR_UMBRAL_MULTIPLICADOR=0.8
