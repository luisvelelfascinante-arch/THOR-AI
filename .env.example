# Copia este archivo como ".env" (sin .example) y completa tus datos reales.
# El archivo ".env" NUNCA debe subirse a git ni compartirse.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MetaTrader 5 (opcional) ---
# Si los dejas vacíos, THOR usa la sesión ya abierta en tu terminal MT5 local.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Estrategia / operación ---
PROBABILIDAD_MINIMA=90
INTERVALO_ESCANEO_SEGUNDOS=15
COOLDOWN_MINUTOS=3
MODO=PRACTICA

# NUEVO en v2: motor de decisión.
#   confluencia_total -> comportamiento v1 (6/6 obligatorio). Por defecto.
#   score_ponderado    -> motor nuevo (Fase 3). NO lo actives en vivo sin
#                         antes correr backtesting/run_backtest.py y
#                         comparar resultados contra confluencia_total.
STRATEGY_MODE=confluencia_total

# NUEVO en v2: payout real de tu bróker/IQ Option, para que el profit
# factor del backtesting sea correcto (no lo dejes en el valor por defecto
# sin verificarlo contra tu plataforma).
PAYOUT_PCT=0.87

# NUEVO en v2: gestor de riesgo (notificaciones, no ejecución de órdenes).
MAX_SENALES_POR_HORA=4
MAX_SENALES_POR_PAR_POR_DIA=6
MAX_PERDIDAS_CONSECUTIVAS=4

# NUEVO en v2.1: filtro de volatilidad ATR (evita señales en mercado
# "choppy" de baja volatilidad — ver indicators/volatility_filter.py).
# Apagado por defecto: compáralo en backtesting antes de activarlo.
ATR_FILTRO_ACTIVO=false
ATR_UMBRAL_MULTIPLICADOR=0.8
